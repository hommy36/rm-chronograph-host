{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rm-chronograph-host",
  "version": "0.9.1",
  "identifier": "com.rm-chronograph.host",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "测速模块上位机",
        "decorations": false,
        "dragDropEnabled": false,
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "XianYu_in_oven",
    "shortDescription": "RoboMaster 摩擦轮测速模块上位机",
    "longDescription": "弹速采集与分组统计、摩擦轮掉速分析（VOFA+ JustFloat）、靶纸散布分析与多组对比、数据持久化与报告导出。",
    "license": "MIT",
    "homepage": "https://github.com/hommy36/rm-chronograph-host",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
